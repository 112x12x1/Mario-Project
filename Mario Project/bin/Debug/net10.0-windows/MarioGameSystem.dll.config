<?xml version="1.0" encoding="utf-8" ?>
<configuration>
    <connectionStrings>
        <add name="MarioDB" 
             connectionString="Data Source=.;Initial Catalog=MarioGameDB;Integrated Security=True" 
             providerName="System.Data.SqlClient" />
    </connectionStrings>
    <appSettings>
        <add key="HighScoreFilePath" value="scores.txt" />
        <add key="TargetFPS" value="60" />
    </appSettings>
</configuration>